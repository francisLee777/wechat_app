<wxs src="../../utils/tools.wxs" module="tools" />
<view class="container" wx:if="{{family}}">
  <!-- 家庭信息 -->
  <view class="family-card">
    <view class="family-name">{{family.name}}</view>
    <view class="family-id" bindtap="copyFamilyId">
      邀请码(家庭ID): {{family.id}} 
      <text class="copy-hint">(点击复制)</text>
    </view>
  </view>

  <!-- 成员列表 -->
  <view class="section-title">家庭成员 ({{members.length}}人)</view>
  <view class="member-list">
    <view class="member-item" wx:for="{{members}}" wx:key="id">
      <view class="member-info">
        <image 
          class="member-avatar" 
          src="{{item.avatarUrl ? tools.resolveUrl(item.avatarUrl, token) : '/assets/images/default_avatar.png'}}" 
          mode="aspectFill"
        ></image>
        <view class="member-detail">
          <text class="member-name">
            {{item.nickName}}
            <text wx:if="{{item.id === currentUser.id}}">(我)</text>
          </text>
          <text class="member-role">{{item.role === 'admin' ? '家长' : '成员'}}</text>
        </view>
      </view>
      
      <!-- 家长管理操作 -->
      <view class="member-action" wx:if="{{currentUser.role === 'admin' && item.role !== 'admin'}}">
        <button size="mini" type="warn" bindtap="handleRemove" data-id="{{item.id}}" data-name="{{item.nickName}}">移除</button>
      </view>
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="footer-action">
    <button class="btn-quit" bindtap="handleQuit" wx:if="{{currentUser.role !== 'admin'}}">退出家庭</button>
    <button class="btn-quit" style="background-color: #ff4d4f; color: white;" bindtap="handleDelete" wx:if="{{currentUser.role === 'admin'}}">解散家庭</button>
  </view>
</view>

<!-- 空状态：未加入家庭 -->
<view class="empty-container" wx:else>
  <image class="empty-img" src="/assets/images/tab_family.png" mode="aspectFit"></image>
  <view class="empty-text">您还没有加入任何家庭</view>
  <view class="empty-actions">
    <navigator url="/pages/family/create" class="btn-primary">创建新家庭</navigator>
    <navigator url="/pages/family/join" class="btn-secondary">加入现有家庭</navigator>
  </view>
</view>
