.container {
  padding: 20px;
}

.family-card {
  background-color: #07c160;
  padding: 30px;
  border-radius: 10px;
  color: white;
  margin-bottom: 30px;
  text-align: center;
  box-shadow: 0 4px 10px rgba(7, 193, 96, 0.3);
}

.family-name {
  font-size: 24px;
  font-weight: bold;
  margin-bottom: 10px;
}

.family-id {
  font-size: 14px;
  opacity: 0.9;
}

.copy-hint {
  text-decoration: underline;
  margin-left: 5px;
}

.section-title {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 15px;
  color: #333;
}

.member-list {
  background-color: #fff;
  border-radius: 10px;
  overflow: hidden;
}

.member-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px;
  border-bottom: 1px solid #f0f0f0;
}

.member-item:last-child {
  border-bottom: none;
}

.member-info {
  display: flex;
  align-items: center;
}

.avatar-placeholder {
  width: 40px;
  height: 40px;
  background-color: #eee;
  border-radius: 50%;
  text-align: center;
  line-height: 40px;
  margin-right: 15px;
  font-size: 18px;
  color: #666;
}

.member-detail {
  display: flex;
  flex-direction: column;
}

.member-name {
  font-size: 16px;
  color: #333;
}

.member-role {
  font-size: 12px;
  color: #999;
  margin-top: 2px;
}

.footer-action {
  margin-top: 40px;
}

.btn-quit {
  background-color: #f8f8f8;
  color: #fa5151;
  border: 1px solid #ddd;
}
