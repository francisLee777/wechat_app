.container {
  padding: 15px;
  padding-bottom: 90px;
}

.search-bar {
  margin-bottom: 20px;
}

.search-bar input {
  background-color: #fff;
  padding: 12px 15px;
  border-radius: 25px;
  border: 1px solid #f0f0f0;
  font-size: 14px;
}

/* 垂直列表布局 */
.recipe-list {
  display: flex;
  flex-direction: column;
}

.recipe-item {
  width: 100%;
  background-color: #fff;
  border-radius: 12px;
  overflow: hidden;
  margin-bottom: 15px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
  display: flex; /* 改为 flex 布局 */
  height: 100px;
  transition: transform 0.1s;
  z-index: 1;
}

/* 拖拽时的样式 */
.recipe-item.dragging {
  box-shadow: 0 10px 20px rgba(0,0,0,0.2);
  z-index: 100;
  opacity: 0.9;
  transform: scale(1.02);
  position: relative;
}

.recipe-img {
  width: 100px;
  height: 100px;
  background-color: #f5f5f5;
  flex-shrink: 0;
}

.recipe-info {
  flex: 1;
  padding: 12px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
}

.recipe-name {
  font-size: 18px;
  font-weight: bold;
  color: #333;
  margin-bottom: 5px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.recipe-desc {
  font-size: 14px;
  color: #888;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 拖拽手柄 */
.drag-handle {
  width: 50px;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #fafafa;
  border-left: 1px solid #f0f0f0;
  cursor: grab;
}

.drag-icon {
  font-size: 20px;
  color: #ccc;
}

.drag-handle:active .drag-icon {
  color: #07c160;
}

.empty-tip {
  width: 100%;
  text-align: center;
  color: #999;
  margin-top: 50px;
}

.fab-btn {
  position: fixed;
  bottom: 40px;
  right: 30px;
  width: 56px;
  height: 56px;
  background-color: #07c160;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 15px rgba(7, 193, 96, 0.4);
  color: white;
  font-size: 32px;
  font-weight: 300;
  transition: transform 0.1s;
}

.fab-btn:active {
  transform: scale(0.95);
}
