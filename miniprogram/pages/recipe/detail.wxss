.container {
  padding-bottom: 40px;
}
 
.swiper-wrapper {
  position: relative;
  width: 100%;
  height: 300px;
  margin-top: 0;
} 

.swiper-container {
  width: 100%;
  height: 100%;
  background-color: #f0f0f0;
}

.swiper-image { 
  width: 100%;
  height: 100%;
}

.image-counter {
  position: absolute;
  top: 15px;
  right: 15px;
  background-color: rgba(0, 0, 0, 0.5);
  color: white;
  padding: 4px 10px;
  border-radius: 12px;
  font-size: 12px;
  z-index: 10;
}

.no-image {
  height: 300px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 16px;
  background-color: #f0f0f0;
}

.content-area {
  padding: 24px;
  background-color: #fff;
  border-radius: 24px 24px 0 0;
  margin-top: -24px;
  position: relative;
  min-height: 400px;
  z-index: 1; /* 确保覆盖在 swiper 上 */
}

.header {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 24px;
  border-bottom: 1px solid #f0f0f0;
  padding-bottom: 16px;
}

.title {
  font-size: 26px;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  width: 100%;
  margin-bottom: 12px;
}

.creator-info {
  display: flex;
  align-items: center;
  width: 100%;
}

.creator-avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  margin-right: 10px;
  border: 1px solid #eee;
}

.creator-meta {
  display: flex;
  flex-direction: column;
}

.creator-name {
  font-size: 14px;
  color: #333;
  font-weight: 500;
}

.create-time {
  font-size: 12px;
  color: #999;
  margin-top: 2px;
}

.section-title {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 16px;
  color: #333;
  border-left: 4px solid #07c160;
  padding-left: 10px;
}

.desc {
  font-size: 17px;
  line-height: 1.8;
  color: #444;
  white-space: pre-wrap; /* 保留换行符 */
  display: block;
}

.error {
  text-align: center;
  margin-top: 50px;
  color: #999;
}

/* 悬浮编辑按钮 */
.fab-edit {
  position: fixed;
  bottom: 40px;
  right: 30px;
  width: 50px;
  height: 50px;
  background-color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 15px rgba(0,0,0,0.15);
  color: #333;
  font-size: 24px;
  z-index: 100;
  border: 1px solid #eee;
}

.fab-edit:active {
  background-color: #f5f5f5;
}

/* 悬浮删除按钮（与编辑并列） */
.fab-delete {
  position: fixed;
  bottom: 40px;
  right: 90px; /* 左移一些，避免与编辑重叠 */
  width: 50px;
  height: 50px;
  background-color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 15px rgba(0,0,0,0.15);
  color: #fa5151;
  font-size: 20px;
  z-index: 100;
  border: 1px solid #eee;
}

.fab-delete:active {
  background-color: #fff5f5;
}
