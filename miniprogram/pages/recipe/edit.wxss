page {
  height: 100%;
}

.container {
  padding: 12px;
  padding-bottom: 20px;
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.form-group {
  margin-bottom: 20px;
  flex-shrink: 0;
  width: 100%;
}

.form-group.content-group {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-bottom: 20px;
  min-height: 0; /* 关键：允许 flex 子项缩小 */
}

.label {
  display: block;
  margin-bottom: 10px;
  font-weight: bold;
  font-size: 16px;
  color: #333;
  flex-shrink: 0;
}

input {
  width: 100%;
  border: 1px solid #e0e0e0;
  border-radius: 8px;
  padding: 12px;
  background-color: #fff;
  box-sizing: border-box;
  font-size: 16px;
  height: 48px;
}

.content-input {
  width: 100%;
  border: 1px solid #e0e0e0;
  border-radius: 8px;
  padding: 12px;
  background-color: #fff;
  box-sizing: border-box;
  font-size: 16px;
  line-height: 1.5;
  flex: 1; /* 撑满剩余高度 */
  height: 100%; /* 确保高度生效 */
}

/* 图片列表样式 */
.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 15px;
}

.image-item {
  width: 90px;
  height: 90px;
  position: relative;
  border-radius: 8px;
  overflow: hidden;
  border: 1px solid #eee;
}

.image-item image {
  width: 100%;
  height: 100%;
}

.delete-tag {
  position: absolute;
  top: 0;
  right: 0;
  background-color: rgba(0,0,0,0.5);
  color: white;
  width: 24px;
  height: 24px;
  text-align: center;
  line-height: 24px;
  font-size: 16px;
  border-bottom-left-radius: 8px;
}

.image-uploader {
  width: 90px;
  height: 90px;
  border: 1px dashed #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f9f9f9;
  border-radius: 8px;
}

.placeholder {
  font-size: 30px;
  color: #ccc;
}

.btn-area {
  flex-shrink: 0;
}

.btn-area button {
  margin-bottom: 15px;
}

.btn-primary {
  background-color: #07c160;
  color: white;
}

.btn-danger {
  background-color: #fa5151;
  color: white;
}
