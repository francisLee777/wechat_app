<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <input placeholder="搜索食谱..." bindinput="onSearchInput" value="{{keyword}}" />
  </view>

  <!-- 食谱列表 (垂直布局) -->
  <view class="recipe-list">
    <block wx:for="{{recipes}}" wx:key="id">
      <view 
        class="recipe-item" 
        style="{{listStyles[index]}}"
        bindtap="goToDetail" 
        data-id="{{item.id}}"
      >
        <!-- 左侧图片 -->
        <image 
          class="recipe-img" 
          src="{{(item.images && item.images.length > 0) ? item.images[0] : (item.image || '/assets/default_food.png')}}" 
          mode="aspectFill"
        ></image>
        
        <!-- 中间内容 -->
        <view class="recipe-info">
          <text class="recipe-name">{{item.name}}</text>
          <text class="recipe-desc">{{item.content}}</text>
        </view>

        <!-- 拖拽手柄 (仅家长可见) -->
        <view 
          class="drag-handle" 
          catchtouchstart="handleDragStart" 
          catchtouchmove="handleDragMove" 
          catchtouchend="handleDragEnd"
          data-index="{{index}}"
          wx:if="{{isAdmin && !keyword}}"
        >
          <view class="drag-icon">☰</view>
        </view>
      </view>
    </block>
    <view wx:if="{{recipes.length === 0}}" class="empty-tip">暂无食谱</view>
  </view>

  <!-- 添加按钮 -->
  <view class="fab-btn" bindtap="goToAdd" wx:if="{{isAdmin}}">
    <text>+</text>
  </view>
</view>
